# Copy this file to .env and replace every placeholder.
NODE_ENV=development
PORT=5000

# PostgreSQL connection strings
# Application runtime: use Neon pooled URL (pooling enabled) in production.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DB?sslmode=require
# Prisma migrations: use Neon direct URL (pooling disabled) in production.
DIRECT_URL=postgresql://USERNAME:PASSWORD@HOST/DB?sslmode=require

# Use long, random, independent secrets (at least 32 bytes each).
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_EXPIRY=8h
JWT_REFRESH_EXPIRY=7d

# Frontend origin allowed by CORS
CORS_ORIGIN=http://localhost:5173

# Global API rate limit
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Login rate limit
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX_REQUESTS=50
LOGIN_RATE_LIMIT_MAX_IPS=50000

# Optional valid bcrypt hash used for timing equalization on unknown usernames.
# Keep the default in config unless you have a reason to override it.
