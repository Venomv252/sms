generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUPER_ADMIN
  DIRECTOR
  ADMIN // Deprecated legacy value; migrated to SUPER_ADMIN
  PRINCIPAL
  MANAGEMENT
  TEACHER
  ACCOUNTANT
  DRIVER
  STUDENT
  PARENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  MEDICAL
}

enum HomeworkStatus {
  PENDING
  SUBMITTED
  EVALUATED
  LATE
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  PARTIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  SUBMITTED
  LATE
  EVALUATED
}

enum ComplaintStatus {
  SUBMITTED
  UNDER_REVIEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ComplaintPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  APPROVE
  REJECT
}

enum NoticeAudience {
  ALL_STAFF
  TEACHERS
  ACCOUNTANTS
  TRANSPORT_STAFF
  OTHER_EMPLOYEES
  ALL_STUDENTS
  PARENTS
  SELECTED_CLASSES
  SELECTED_DEPARTMENTS
  CUSTOM
}

model School {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  notices   Notice[]
  directorLinks DirectorSchool[]
  complaints Complaint[]
  academicEvents AcademicEvent[]
  inventoryItems InventoryItem[]
  auditLogs AuditLog[]
  buses Bus[]
  admissionApplications AdmissionApplication[]

  @@map("schools")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  password     String
  role         UserRole @default(STUDENT)
  schoolId     String?
  firstName    String
  lastName     String
  tokenVersion Int      @default(1) // Increment to invalidate all user sessions
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school         School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  ownedSchools   DirectorSchool[]
  student        Student?
  parentLinks    ParentStudent[] @relation("ParentUser")
  teacher        Teacher?
  accountant     Accountant?
  notes          Note[]
  doubts         Doubt[]        @relation("DoubtAuthor")
  comments       DoubtComment[]
  leaveRequests  LeaveRequest[]
  refreshTokens  RefreshToken[]

  @@index([schoolId, role])
  @@map("users")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  tokenHash  String   @unique // bcrypt hash of the actual refresh token
  expiresAt  DateTime
  deviceInfo String?  // User agent + IP hash for security tracking
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt]) // For cleanup job
  @@map("refresh_tokens")
}

model DirectorSchool {
  id         String   @id @default(uuid())
  directorId String
  schoolId   String
  createdAt  DateTime @default(now())

  director User   @relation(fields: [directorId], references: [id], onDelete: Cascade)
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([directorId, schoolId])
  @@index([schoolId])
  @@map("director_schools")
}

model Student {
  id              String   @id @default(uuid())
  userId          String   @unique
  rollNumber      String   @unique
  grade           String
  section         String
  admissionNumber String   @unique
  dateOfBirth     DateTime
  address         String?
  phoneNumber     String?
  parentName      String?
  parentEmail     String?
  parentPhone     String?
  bloodGroup      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentLinks  ParentStudent[]
  attendance   Attendance[]
  submissions  HomeworkSubmission[]
  results      Result[]
  fees         FeePayment[]
  certificates Certificate[]
  leaves       LeaveRequest[]

  @@map("students")
}

model ParentStudent {
  id           String   @id @default(uuid())
  parentUserId String
  studentId    String
  createdAt    DateTime @default(now())

  parent  User    @relation("ParentUser", fields: [parentUserId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentUserId, studentId])
  @@index([studentId])
  @@map("parent_students")
}

model Teacher {
  id          String   @id @default(uuid())
  userId      String   @unique
  employeeId  String   @unique
  department  String
  designation String
  phoneNumber String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjects Subject[]
  classes  Class[]

  @@map("teachers")
}

model Subject {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  description String?
  teacherId   String
  credits     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher  Teacher   @relation(fields: [teacherId], references: [id])
  classes  Class[]
  homework Homework[]
  results  Result[]
  notes    Note[]

  @@map("subjects")
}

model Class {
  id           String   @id @default(uuid())
  name         String
  grade        String
  section      String
  subjectId    String
  teacherId    String
  academicYear String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject    Subject      @relation(fields: [subjectId], references: [id])
  teacher    Teacher      @relation(fields: [teacherId], references: [id])
  attendance Attendance[]
  schedule   Schedule[]
  homework   Homework[]

  @@map("classes")
}

model Attendance {
  id        String           @id @default(uuid())
  studentId String
  classId   String
  date      DateTime
  status    AttendanceStatus
  remarks   String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class   Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date])
  @@index([studentId, date])
  @@map("attendance")
}

model Homework {
  id          String   @id @default(uuid())
  title       String
  description String
  subjectId   String
  classId     String
  dueDate     DateTime
  totalMarks  Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subject     Subject              @relation(fields: [subjectId], references: [id])
  class       Class                @relation(fields: [classId], references: [id])
  submissions HomeworkSubmission[]

  @@map("homework")
}

model HomeworkSubmission {
  id            String           @id @default(uuid())
  homeworkId    String
  studentId     String
  status        SubmissionStatus @default(SUBMITTED)
  textAnswer    String?
  fileUrl       String?
  submittedAt   DateTime         @default(now())
  marksObtained Int?
  feedback      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([homeworkId, studentId])
  @@map("homework_submissions")
}

model Result {
  id            String   @id @default(uuid())
  studentId     String
  subjectId     String
  examType      String
  theoryMarks   Int
  internalMarks Int
  totalMarks    Int
  grade         String
  remarks       String?
  academicYear  String
  term          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@map("results")
}

model FeePayment {
  id            String        @id @default(uuid())
  studentId     String
  amount        Decimal       @db.Decimal(10, 2)
  term          String
  academicYear  String
  status        PaymentStatus @default(PENDING)
  paymentMethod String?
  transactionId String?       @unique
  receiptNumber String?       @unique
  paymentDate   DateTime?
  dueDate       DateTime
  remarks       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([studentId, status])
  @@map("fee_payments")
}

model Notice {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String
  priority    String   @default("NORMAL")
  publishDate DateTime @default(now())
  expiryDate  DateTime?
  isActive    Boolean  @default(true)
  schoolId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipients NoticeRecipient[]

  @@index([schoolId, isActive, publishDate])
  @@map("notices")
}

model Schedule {
  id        String   @id @default(uuid())
  classId   String
  dayOfWeek String
  period    Int
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, period], name: "schedule_class_day_period_unique")
  @@index([dayOfWeek, startTime, endTime])
  @@index([room, dayOfWeek, startTime])
  @@map("schedules")
}


model Certificate {
  id          String   @id @default(uuid())
  studentId   String
  title       String
  description String
  issueDate   DateTime @default(now())
  fileUrl     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model LeaveRequest {
  id        String      @id @default(uuid())
  userId    String
  studentId String?
  fromDate  DateTime
  toDate    DateTime
  reason    String
  status    LeaveStatus @default(PENDING)
  adminNote String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

model Note {
  id        String   @id @default(uuid())
  title     String
  content   String
  userId    String
  subjectId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@map("notes")
}

model Doubt {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User           @relation("DoubtAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  comments DoubtComment[]

  @@map("doubts")
}

model DoubtComment {
  id        String   @id @default(uuid())
  content   String
  doubtId   String
  authorId  String
  createdAt DateTime @default(now())

  doubt  Doubt @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("doubt_comments")
}

// Accountant model for financial management
model Accountant {
  id          String   @id @default(uuid())
  userId      String   @unique
  employeeId  String   @unique
  phoneNumber String?
  address     String?
  permissions Json?    // Stores permission flags: {feeCollection, concessions, expenses, payroll, reports, approvals}
  approvalLimit Decimal? @db.Decimal(10, 2) // Maximum amount they can approve without Principal
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("accountants")
}

// Complaint/Grievance management
model Complaint {
  id          String            @id @default(uuid())
  title       String
  description String
  category    String
  priority    ComplaintPriority @default(NORMAL)
  status      ComplaintStatus   @default(SUBMITTED)
  submittedBy String            // User ID
  schoolId    String
  assignedTo  String?           // User ID of staff handling it
  resolution  String?
  remarks     String?
  isConfidential Boolean        @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  resolvedAt  DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status, priority])
  @@map("complaints")
}

// Academic Calendar Events
model AcademicEvent {
  id           String    @id @default(uuid())
  title        String
  description  String?
  eventType    String    // HOLIDAY, WORKING_DAY, EXAM, SCHOOL_EVENT, EMERGENCY_CLOSURE
  startDate    DateTime
  endDate      DateTime?
  schoolId     String
  notifyStaff  Boolean   @default(false)
  notifyStudents Boolean @default(false)
  notifyParents Boolean  @default(false)
  createdBy    String    // User ID
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, startDate])
  @@map("academic_events")
}

// Inventory/Infrastructure management
model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String   // CLASSROOM, LABORATORY, LIBRARY, FURNITURE, EQUIPMENT, VEHICLE
  location    String?
  quantity    Int      @default(1)
  condition   String?  // EXCELLENT, GOOD, FAIR, POOR, DAMAGED
  purchaseDate DateTime?
  warrantyExpiry DateTime?
  schoolId    String
  maintenanceNotes String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  maintenanceRequests MaintenanceRequest[]

  @@index([schoolId, category])
  @@map("inventory_items")
}

// Maintenance tracking
model MaintenanceRequest {
  id          String   @id @default(uuid())
  itemId      String
  description String
  priority    String   @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, CANCELLED
  reportedBy  String   // User ID
  assignedTo  String?  // User ID
  cost        Decimal? @db.Decimal(10, 2)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  item InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@map("maintenance_requests")
}

// Audit Log for security and compliance
model AuditLog {
  id          String      @id @default(uuid())
  userId      String      // Who performed the action
  schoolId    String?     // Which school (null for platform-level actions)
  action      AuditAction
  entityType  String?     // User, Student, Fee, Notice, etc.
  entityId    String?     // ID of the affected record
  changes     Json?       // Before/after values
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now())

  school School? @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Transport/Bus tracking
model Bus {
  id              String   @id @default(uuid())
  busNumber       String   @unique
  registrationNumber String @unique
  capacity        Int
  driverId        String?
  schoolId        String
  isActive        Boolean  @default(true)
  insuranceExpiry DateTime?
  fitnessExpiry   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  trips  Trip[]

  @@index([schoolId, isActive])
  @@map("buses")
}

// Bus trips
model Trip {
  id          String   @id @default(uuid())
  busId       String
  routeName   String
  startTime   DateTime
  endTime     DateTime?
  status      String   @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, DELAYED, CANCELLED
  delayMinutes Int?
  remarks     String?
  currentLatitude  Float?
  currentLongitude Float?
  lastLocationUpdate DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bus Bus @relation(fields: [busId], references: [id], onDelete: Cascade)
  locationHistory BusLocationHistory[]

  @@index([busId, startTime])
  @@index([status])
  @@map("trips")
}

// GPS tracking history for buses
model BusLocationHistory {
  id         String   @id @default(uuid())
  tripId     String
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@map("bus_location_history")
}

// Enhanced Notice model relationships (keeping existing Notice model, adding audience targeting)
model NoticeRecipient {
  id        String   @id @default(uuid())
  noticeId  String
  userId    String?  // Specific user (optional)
  audience  NoticeAudience
  classGrade String? // For SELECTED_CLASSES
  classSection String? // For SELECTED_CLASSES
  department String? // For SELECTED_DEPARTMENTS
  viewedAt  DateTime?
  acknowledgedAt DateTime?
  createdAt DateTime @default(now())

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)

  @@index([noticeId, userId])
  @@index([audience, classGrade, classSection])
  @@map("notice_recipients")
}

// Student admission applications
model AdmissionApplication {
  id              String   @id @default(uuid())
  studentName     String
  dateOfBirth     DateTime
  parentName      String
  parentEmail     String
  parentPhone     String
  appliedGrade    String
  previousSchool  String?
  address         String
  schoolId        String
  status          String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  reviewedBy      String?  // User ID
  reviewNotes     String?
  applicationDate DateTime @default(now())
  reviewedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("admission_applications")
}
